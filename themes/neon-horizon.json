{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#262335",
    "--editor-surface": "#262335",
    "--foreground": "#f4eefa",
    "--card": "#241b2f",
    "--card-foreground": "#f4eefa",
    "--popover": "#171520",
    "--popover-foreground": "#f4eefa",
    "--primary": "#ff7edb",
    "--primary-foreground": "#171520",
    "--secondary": "#34294f",
    "--secondary-foreground": "#f4eefa",
    "--muted": "#2a2139",
    "--muted-foreground": "#a8acd6",
    "--accent": "#3b2f5a",
    "--accent-foreground": "#ffffff",
    "--border": "#3f3557",
    "--input": "#4a3f66",
    "--ring": "#ff7edb",
    "--chart-1": "#ff7edb",
    "--chart-2": "#36f9f6",
    "--chart-3": "#fede5d",
    "--chart-4": "#72f1b8",
    "--chart-5": "#f97e72",
    "--sidebar": "#241b2f",
    "--sidebar-foreground": "#f4eefa",
    "--sidebar-primary": "#ff7edb",
    "--sidebar-primary-foreground": "#171520",
    "--sidebar-accent": "#34294f",
    "--sidebar-accent-foreground": "#ffffff",
    "--sidebar-border": "#3f3557",
    "--sidebar-ring": "#ff7edb",
    "--worktree-sidebar": "#171520",
    "--worktree-sidebar-foreground": "#f4eefa",
    "--worktree-sidebar-accent": "#2a2139",
    "--worktree-sidebar-accent-foreground": "#ffffff",
    "--worktree-sidebar-border": "#2a2139",
    "--worktree-sidebar-ring": "#ff7edb",
    "--worktree-sidebar-active": "#ff7edb26",
    "--worktree-sidebar-active-border": "#ff7edb",
    "--tab-bar": "#1e1a2b",
    "--tab-active": "#262335",
    "--tab-active-foreground": "#ffffff",
    "--tab-active-indicator": "#ff7edb",
    "--tab-inactive": "#1e1a2b",
    "--tab-inactive-foreground": "#a8acd6",
    "--split-divider": "#2a2139",
    "--split-divider-hover": "#ff7edb",
    "--chat-user-message": "#34294f",
    "--text-link": "#36f9f6",
    "--diff-added": "#72f1b8",
    "--diff-added-background": "#72f1b81a",
    "--diff-added-emphasis": "#72f1b840",
    "--diff-added-gutter": "#72f1b8",
    "--diff-removed": "#fe4450",
    "--diff-removed-background": "#fe44501a",
    "--diff-removed-emphasis": "#fe445040",
    "--diff-removed-gutter": "#fe4450",
    "--git-decoration-added": "#72f1b8",
    "--git-decoration-modified": "#fede5d",
    "--git-decoration-deleted": "#fe4450",
    "--git-decoration-renamed": "#36f9f6",
    "--git-decoration-untracked": "#72f1b8",
    "--git-decoration-copied": "#36f9f6",
    "--git-decoration-ignored": "#848bbd"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#848bbd", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "keyword.control"], "settings": { "foreground": "#fede5d" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#fede5d" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#ff8b39" } },
    { "scope": ["string.regexp", "constant.character.escape"], "settings": { "foreground": "#f97e72" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"], "settings": { "foreground": "#f97e72" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#36f9f6" } },
    { "scope": ["variable", "meta.definition.variable", "variable.other.readwrite"], "settings": { "foreground": "#ff7edb" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#ff7edb", "fontStyle": "italic" } },
    { "scope": ["variable.language", "variable.language.this"], "settings": { "foreground": "#fe4450", "fontStyle": "italic" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#fe4450" } },
    { "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#72f1b8" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#fede5d", "fontStyle": "italic" } },
    { "scope": ["support.type.property-name", "meta.object-literal.key", "variable.other.property"], "settings": { "foreground": "#ff7edb" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#ff7edb", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#fede5d", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#72f1b8", "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "markup.link"], "settings": { "foreground": "#36f9f6", "fontStyle": "underline" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#72f1b8" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#fe4450" } },
    { "scope": ["invalid"], "settings": { "foreground": "#fe4450", "fontStyle": "underline" } }
  ]
}
